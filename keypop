#!/bin/bash
# keypop — secure secret intake via native popup. Values never touch chat, transcript, or logs.
#
# The problem: when an AI coding agent needs a credential, the naive flow is "paste it
# in chat" — where it lands in transcript history, logs, and the model's context. keypop
# closes that hole: the value is collected out-of-band in a native dialog and written
# straight to a local gitignored file. It never transits the model's context.
#
# Modes:
#   keypop NAME[:note] [NAME2[:note2] ...]   one masked dialog per secret (agent flow)
#   keypop --paste                           paste a .env-style block, extract all pairs at once
#   keypop --import <file>                   load an existing .env file into the vault
#   keypop --env <file> NAME [...]           also treat a project .env as present/mirror target
#
# Check-first: a name the vault (or the --env file) already has is skipped silently (no dialog)
# and reported as "already set". Pass --force to prompt and replace an existing value (rotate).
#
# Masked by default. "Reveal" unmasks what you typed (to verify a paste), "Hide" re-masks.
# Enter = Save. Blank + Save skips. Esc / "Cancel all" stops the rest.
#
# Vault location: $VAULT_FILE, default ~/.keypop/vault.env  (chmod 600).
# macOS only (uses osascript). Linux zenity/kdialog port welcome — see README.
set -uo pipefail
VAULT="${VAULT_FILE:-$HOME/.keypop/vault.env}"

usage() {
  cat <<'EOF'
usage:
  keypop NAME[:note] [NAME2[:note2] ...]   one masked dialog per secret
  keypop --paste                           paste a .env-style block, extract all pairs
  keypop --import <file>                   load an existing .env file into the vault
  keypop --env <file> NAME [...]           also check/write NAME in a project .env
  keypop --force NAME [...]                 prompt even if the vault already has it (rotate)
  keypop --help

Names the vault already has are skipped (no dialog) unless you pass --force.
With --env, a name already in that .env also counts as set, and saved keys are
mirrored into it. In any dialog: Reveal/Hide toggles masking, Enter saves, blank + Save skips.
EOF
}

# trim leading/trailing whitespace
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }

# ask_masked MSG TITLE — one dialog with an in-place Reveal/Hide toggle.
# Echoes the entered value on Save (exit 0); exit 1 on Cancel all / Esc.
ask_masked() {
  local msg="$1" title="$2" val="" hidden=1 out btn hclause tgl dlg
  while :; do
    if [ "$hidden" -eq 1 ]; then hclause="with hidden answer"; tgl="Reveal"; else hclause=""; tgl="Hide"; fi
    # only our own label ($tgl) is interpolated into the script; all user data goes via argv
    dlg="tell application \"System Events\" to set r to display dialog (item 1 of argv) default answer (item 3 of argv) $hclause with title (item 2 of argv) buttons {\"Cancel all\",\"$tgl\",\"Save\"} default button \"Save\" cancel button \"Cancel all\""
    out=$(osascript \
      -e 'on run argv' \
      -e 'tell application "System Events" to activate' \
      -e "$dlg" \
      -e 'return (button returned of r) & linefeed & (text returned of r)' \
      -e 'end run' "$msg" "$title" "$val" 2>/dev/null) || return 1
    btn="${out%%$'\n'*}"
    val="${out#*$'\n'}"
    case "$btn" in
      Reveal) hidden=0 ;;
      Hide)   hidden=1 ;;
      *)      printf '%s' "$val"; return 0 ;;
    esac
  done
}

# file_has FILE NAME — true if FILE exists and defines NAME
file_has() { [ -f "$1" ] && grep -q "^${2}=" "$1"; }

# file_put FILE NAME VALUE [COMMENT] — replace any existing entry, then append fresh.
# COMMENT (optional) is written as a leading `# ...` line for provenance.
file_put() {
  local file="$1" name="$2" val="$3" comment="${4:-}"
  mkdir -p "$(dirname "$file")"
  touch "$file" 2>/dev/null || true
  chmod 600 "$file" 2>/dev/null || true
  if grep -q "^${name}=" "$file"; then
    grep -v "^${name}=" "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    chmod 600 "$file" 2>/dev/null || true
  fi
  {
    [ -n "$comment" ] && printf '# %s\n' "$comment"
    printf '%s=%s\n' "$name" "$val"
  } >> "$file"
}

# vault_put NAME VALUE [NOTE] — write to the vault, with a dated provenance comment
vault_put() { file_put "$VAULT" "$1" "$2" "${3:-$1} — added $(date +%F)"; }

# keypop_parse — read a .env-style blob on stdin, emit valid NAME<TAB>value lines.
# Skips blanks, comments, and non-KEY=value lines; validates the name; strips one
# layer of surrounding quotes. Splits on the FIRST '=' so base64/URL values survive.
keypop_parse() {
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    line="$(trim "$line")"
    [ -z "$line" ] && continue
    [ "${line:0:1}" = "#" ] && continue
    line="${line#export }"
    case "$line" in *=*) ;; *) continue ;; esac
    k="$(trim "${line%%=*}")"
    [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    v="$(trim "${line#*=}")"
    if [ "${#v}" -ge 2 ] && { [ "${v:0:1}${v: -1}" = '""' ] || [ "${v:0:1}${v: -1}" = "''" ]; }; then
      v="${v:1:${#v}-2}"
    fi
    printf '%s\t%s\n' "$k" "$v"
  done
}

single_mode() {
  local force=0 envfile="" spec
  local specs=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -f|--force) force=1 ;;
      --env)      shift; envfile="${1:-}" ;;
      --env=*)    envfile="${1#--env=}" ;;
      *)          specs+=("$1") ;;
    esac
    shift
  done
  set -- "${specs[@]+"${specs[@]}"}"

  local total=$# i=0 NAME NOTE MSG TITLE val j rest cur mirrored=()
  local saved=() skipped=() cancelled=() present=()
  for spec in "$@"; do
    i=$((i+1))
    NAME="${spec%%:*}"
    NOTE="${spec#*:}"; [ "$NOTE" = "$spec" ] && NOTE=""
    # check-first: skip the dialog if the vault (or the --env file) already has it (--force overrides)
    if [ "$force" -eq 0 ] && { file_has "$VAULT" "$NAME" || { [ -n "$envfile" ] && file_has "$envfile" "$NAME"; }; }; then
      if file_has "$VAULT" "$NAME"; then cur="$(grep "^${NAME}=" "$VAULT" | tail -1)"; else cur="$(grep "^${NAME}=" "$envfile" | tail -1)"; fi
      cur="${cur#*=}"
      present+=("$NAME (${#cur} chars)")
      continue
    fi
    MSG="Needed: $NAME"
    file_has "$VAULT" "$NAME" && MSG="$MSG"$'\n'"(already in vault — Save replaces it)"
    [ -n "$NOTE" ] && MSG="$MSG"$'\n\n'"$NOTE"
    MSG="$MSG"$'\n\n'"Paste the value. Reveal shows what you typed; blank + Save skips."
    TITLE="keypop ($i of $total)"
    if val=$(ask_masked "$MSG" "$TITLE"); then
      val="${val//$'\n'/}"
      if [ -z "$val" ]; then skipped+=("$NAME"); continue; fi
      vault_put "$NAME" "$val" "$NOTE"
      saved+=("$NAME (${#val} chars)")
      [ -n "$envfile" ] && { file_put "$envfile" "$NAME" "$val"; mirrored+=("$NAME"); }
    else
      cancelled+=("$NAME")
      j=0
      for rest in "$@"; do j=$((j+1)); [ "$j" -le "$i" ] && continue; cancelled+=("${rest%%:*}"); done
      break
    fi
  done
  [ ${#present[@]} -gt 0 ] && echo "already set: ${present[*]}"
  [ ${#mirrored[@]} -gt 0 ] && echo "also written to $envfile: ${mirrored[*]}"
  [ ${#saved[@]} -gt 0 ] && echo "saved: ${saved[*]}"
  [ ${#skipped[@]} -gt 0 ] && echo "skipped: ${skipped[*]}"
  [ ${#cancelled[@]} -gt 0 ] && echo "cancelled: ${cancelled[*]}"
  return 0
}

paste_mode() {
  local blob k v j n existing=0 list="" rep=""
  local names=() vals=()
  blob=$(ask_masked $'Paste one or more lines like NAME=value (a .env block works).\nReveal to check what you pasted; blank + Save cancels.' "keypop — paste keys") || { echo "cancelled"; return 0; }
  [ -z "$(trim "$blob")" ] && { echo "nothing pasted"; return 0; }
  while IFS=$'\t' read -r k v; do
    [ -z "$k" ] && continue
    names+=("$k"); vals+=("$v")
  done < <(printf '%s\n' "$blob" | keypop_parse)
  n=${#names[@]}
  [ "$n" -eq 0 ] && { echo "no NAME=value lines found"; return 0; }
  for ((j=0; j<n; j++)); do
    list="$list"$'\n'"  • ${names[j]}"
    grep -q "^${names[j]}=" "$VAULT" && existing=$((existing+1))
  done
  local cmsg="Found $n key(s):$list"
  [ "$existing" -gt 0 ] && cmsg="$cmsg"$'\n\n'"$existing already in vault — Save replaces."
  # confirm on names only — values are never shown here
  osascript \
    -e 'on run argv' \
    -e 'tell application "System Events" to activate' \
    -e 'tell application "System Events" to display dialog (item 1 of argv) with title "keypop — confirm" buttons {"Cancel","Save all"} default button "Save all" cancel button "Cancel"' \
    -e 'end run' "$cmsg" >/dev/null 2>&1 || { echo "cancelled"; return 0; }
  for ((j=0; j<n; j++)); do vault_put "${names[j]}" "${vals[j]}"; rep="$rep${names[j]} (${#vals[j]} chars) "; done
  echo "saved: $(trim "$rep")"
  return 0
}

# import_mode FILE [--force] — load an existing .env file's pairs into the vault.
# Names the vault already has are skipped (--force replaces). Confirms on names only.
import_mode() {
  local file="" force=0 a k v j n existing=0 list="" rep="" skiplist=""
  local names=() vals=()
  for a in "$@"; do
    case "$a" in -f|--force) force=1 ;; *) [ -z "$file" ] && file="$a" ;; esac
  done
  [ -n "$file" ] || { echo "usage: keypop --import <file> [--force]"; return 1; }
  [ -f "$file" ] || { echo "no such file: $file"; return 1; }
  while IFS=$'\t' read -r k v; do
    [ -z "$k" ] && continue
    if [ "$force" -eq 0 ] && file_has "$VAULT" "$k"; then existing=$((existing+1)); skiplist="$skiplist $k"; continue; fi
    names+=("$k"); vals+=("$v")
  done < <(keypop_parse < "$file")
  n=${#names[@]}
  if [ "$n" -eq 0 ]; then
    [ "$existing" -gt 0 ] && echo "already set (skipped$skiplist)" || echo "no NAME=value lines found in $file"
    return 0
  fi
  for ((j=0; j<n; j++)); do list="$list"$'\n'"  • ${names[j]}"; done
  local cmsg="Import $n key(s) from $file into the vault:$list"
  [ "$existing" -gt 0 ] && cmsg="$cmsg"$'\n\n'"($existing already in vault, skipped — --force to replace)"
  osascript \
    -e 'on run argv' \
    -e 'tell application "System Events" to activate' \
    -e 'tell application "System Events" to display dialog (item 1 of argv) with title "keypop — confirm import" buttons {"Cancel","Import"} default button "Import" cancel button "Cancel"' \
    -e 'end run' "$cmsg" >/dev/null 2>&1 || { echo "cancelled"; return 0; }
  for ((j=0; j<n; j++)); do vault_put "${names[j]}" "${vals[j]}"; rep="$rep${names[j]} (${#vals[j]} chars) "; done
  echo "imported: $(trim "$rep")"
  return 0
}

# --- run dispatch only when executed, not when sourced (e.g. by test-parse.sh) ---
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  command -v osascript >/dev/null || { echo "error: osascript not found (keypop is macOS-only for now)"; exit 1; }
  mkdir -p "$(dirname "$VAULT")" && chmod 700 "$(dirname "$VAULT")"
  touch "$VAULT" && chmod 600 "$VAULT"
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    -p|--paste) paste_mode ;;
    -i|--import) shift; import_mode "$@" ;;
    "") usage; exit 1 ;;
    *) single_mode "$@" ;;
  esac
fi
